{
  "appName": "Research Reader",
  "appDescription": "Summarises papers and answers questions about them.",
  "logoUrl": "/examples/research-reader/logo.svg",
  "logoDarkUrl": "/examples/research-reader/logo-dark.svg",
  "faviconUrl": "/examples/research-reader/favicon.svg",
  "welcomeTitle": "What are we reading today?",
  "welcomeMessage": "Attach a paper as a PDF and ask for a summary, the methods, or how it compares with related work.",
