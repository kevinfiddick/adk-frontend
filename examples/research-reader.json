  "markdown": { "bracketMath": true },
  "theme": {
    "font": "Source Serif 4, Georgia, serif",
    "fontUrl": "https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@400;600&display=swap",
    "buttonRadius": "2px",
    "chatWidth": "56rem",
    "light": {
      "background": "#fdfcf8",
      "sidebarBackground": "#f1ede2",
      "buttonColor": "#7a1f2b",
      "chatBubbleColor": "#f1e4d8"
    },
    "dark": {
      "background": "#1a1814",
      "sidebarBackground": "#221f1a",
      "buttonColor": "#d98c8c",
      "chatBubbleColor": "#3a2f2a"
    }
  }
