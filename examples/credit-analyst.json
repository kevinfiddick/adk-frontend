{
  "appName": "Credit Analyst Assistant",
  "appDescription": "Reads financial statements and drafts credit memos.",
  "logoUrl": "/examples/credit-analyst/logo.svg",
  "logoDarkUrl": "",
  "faviconUrl": "/examples/credit-analyst/favicon.svg",
  "welcomeTitle": "Which borrower are we reviewing?",
  "welcomeMessage": "Attach financial statements or a rating report and I will summarise leverage, coverage and liquidity.",
  "suggestions": [
    "Summarise the attached 10-K",
    "Calculate leverage and coverage ratios",
    "Draft a credit memo outline"
  ],
  "inputPlaceholder": "Ask about a borrower or attach a filing...",
  "footerText": "For internal use only",
  "disclaimer": "Analysis is generated by AI and is not financial advice. Verify figures against source documents.",
  "uploads": {
    "enabled": true,
    "maxFiles": 5,
    "maxFileSizeMb": 15,
    "accept": "application/pdf,text/csv,text/plain,.csv,.txt"
  },
  "fontSize": { "default": 15, "adjustable": true, "min": 13, "max": 22 },
  "markdown": { "bracketMath": false },
  "theme": {
    "mode": "light",
    "font": "IBM Plex Sans, sans-serif",
    "fontUrl": "https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&display=swap",
    "buttonRadius": "4px",
    "codeTheme": "auto",
    "chatWidth": "",
    "light": {
      "background": "#f7f8fa",
      "sidebarBackground": "#0f2a43",
      "buttonColor": "#0b6e4f",
      "chatBubbleColor": "#e3f1ec"
    }
  }
}
