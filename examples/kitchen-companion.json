{
  "appName": "Sous Chef",
  "appDescription": "Suggests recipes from what you have in the kitchen.",
  "logoUrl": "/examples/kitchen-companion/logo.svg",
  "logoDarkUrl": "",
  "faviconUrl": "/examples/kitchen-companion/favicon.svg",
  "welcomeTitle": "What's in the fridge?",
